#!/bin/bash
# intake — положить фото в Handwriting/ и запустить конвейер распознавания.
#
# Источники (в порядке приоритета):
#   intake              — взять картинку из БУФЕРА ОБМЕНА (после вставки в чат по Cmd+V)
#   intake <file>...    — переместить указанные файлы/картинки в Handwriting/
#   intake --glob 'X*'  — переместить всё по маске
#
# После приёма печатает путь и сразу режет на строки (thaiocr lines). Дальше строки
# читаются глазами. Флаг --no-run — только положить, не запускать.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/../../../.." && pwd)"          # корень проекта (th/)
DEST="$ROOT/Handwriting"
THAIOCR="$DIR/thaiocr"
STAMP="$(date +%Y%m%d-%H%M%S)"
RUN=1
FILES=()

mkdir -p "$DEST"

# разбор аргументов
while [ $# -gt 0 ]; do
  case "$1" in
    --no-run) RUN=0; shift ;;
    --glob)   shift; for f in $1; do FILES+=("$f"); done; shift ;;
    *)        FILES+=("$1"); shift ;;
  esac
done

saved=()

if [ ${#FILES[@]} -eq 0 ]; then
  # источник — буфер обмена
  info="$(osascript -e 'clipboard info' 2>/dev/null || true)"

  if printf '%s' "$info" | grep -q 'furl'; then
    # в буфере СКОПИРОВАННЫЙ ФАЙЛ — берём оригинал без потерь (heic/jpg/png…)
    src="$(osascript -e 'POSIX path of (the clipboard as «class furl»)' 2>/dev/null || true)"
    if [ -n "$src" ] && [ -f "$src" ]; then
      ext="${src##*.}"; [ "$ext" = "$src" ] && ext="bin"
      OUT="$DEST/chat-$STAMP.$(printf '%s' "$ext" | tr 'A-Z' 'a-z')"
      cp "$src" "$OUT"; saved+=("$OUT")
    fi

  elif printf '%s' "$info" | grep -q 'JPEG picture'; then
    # в буфере СОДЕРЖИМОЕ картинки — есть JPEG-поток (компактнее и с EXIF)
    OUT="$DEST/chat-$STAMP.jpg"
    osascript >/dev/null 2>&1 <<OSA || true
set d to (the clipboard as «class JPEG»)
set f to open for access (POSIX file "$OUT") with write permission
set eof f to 0
write d to f
close access f
OSA
    [ -s "$OUT" ] && saved+=("$OUT")

  elif printf '%s' "$info" | grep -qE 'PNGf|TIFF picture|class PNGf'; then
    # только растровые флейворы без JPEG — PNG
    OUT="$DEST/chat-$STAMP.png"
    if command -v pngpaste >/dev/null 2>&1 && pngpaste "$OUT" 2>/dev/null; then
      saved+=("$OUT")
    fi
  fi

  if [ ${#saved[@]} -eq 0 ]; then
    echo "intake: в буфере обмена нет картинки (или формат не распознан)." >&2
    echo "  Вставь фото в чат по Cmd+V — оно останется в буфере — и запусти intake снова," >&2
    echo "  либо в Finder выдели файл, Cmd+C, затем intake (тогда HEIC берётся как есть)," >&2
    echo "  либо перетащи файл на папку Handwriting/ в проводнике VS Code." >&2
    exit 1
  fi
else
  # источник — файлы; heic/jpg/png переносим, heic конвертим в png копией
  i=0
  for f in "${FILES[@]}"; do
    [ -f "$f" ] || { echo "intake: нет файла: $f" >&2; continue; }
    i=$((i+1))
    base="chat-$STAMP-$(printf '%02d' $i)"
    ext="${f##*.}"
    dst="$DEST/$base.$ext"
    mv "$f" "$dst"
    saved+=("$dst")
  done
fi

[ ${#saved[@]} -gt 0 ] || { echo "intake: ничего не принято." >&2; exit 1; }

for s in "${saved[@]}"; do echo "принято: $s"; done

if [ "$RUN" -eq 1 ]; then
  for s in "${saved[@]}"; do
    name="$(basename "${s%.*}")"
    outdir="$DEST/.lines/$name"
    mkdir -p "$outdir"
    echo "--- нарезка на строки: $name ---"
    "$THAIOCR" lines "$s" "$outdir" --scale 3 --words-from "$ROOT/progress.json" || true
  done
  echo
  echo "Строки в Handwriting/.lines/<имя>/line-*.png — читать глазами по одной."
fi
